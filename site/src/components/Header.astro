---
import Marca from './Marca.astro';
import { site, whatsappLink } from '../data/site';
const wa = whatsappLink('Olá! Quero conhecer a CICLOS+.');

const links = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#disciplinas', label: 'Disciplinas' },
  { href: '/#cursos-livres', label: 'Cursos livres' },
  { href: '/#viagens', label: 'Viagens' },
  { href: '/#unidades', label: 'Unidades' },
];
---
<header class="topo">
  <div class="topo__barra wrap">
    <a class="topo__marca" href="/" aria-label="CICLOS+, página inicial">
      <Marca tipo="wordmark" label={null} />
    </a>

    <nav class="topo__nav" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <a class="topo__wa" href={wa} target="_blank" rel="noopener" aria-label="Falar no WhatsApp" title="Falar no WhatsApp"><svg class="topo__wa-icone" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z" /><path d="M9.2 8.6c.2 2.6 2.2 4.9 4.9 5.6l1.2-1.3 1.9.9-.4 1.6c-3.8.3-7.9-3.6-8.3-7.4l1.6-.5.9 1.9z" class="topo__wa-fone" /></svg></a>
    <a class="btn topo__cta" href="/#quero-conhecer">Quero conhecer</a>

    <a class="topo__wa topo__wa--movel" href={wa} target="_blank" rel="noopener" aria-label="Falar no WhatsApp"><svg class="topo__wa-icone" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z" /><path d="M9.2 8.6c.2 2.6 2.2 4.9 4.9 5.6l1.2-1.3 1.9.9-.4 1.6c-3.8.3-7.9-3.6-8.3-7.4l1.6-.5.9 1.9z" class="topo__wa-fone" /></svg></a>
    <button class="topo__menu" type="button" aria-expanded="false" aria-controls="menu-movel">
      <span class="topo__menu-linhas" aria-hidden="true"></span>
      <span>Menu</span>
    </button>
  </div>

  <div class="topo__movel" id="menu-movel" hidden>
    <ul class="wrap">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={wa} target="_blank" rel="noopener">WhatsApp {site.whatsapp.display}</a></li>
      <li><a class="btn" href="/#quero-conhecer">Quero conhecer</a></li>
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.topo__menu');
  const menu = document.getElementById('menu-movel');
  const topo = document.querySelector('.topo');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      topo?.classList.toggle('is-aberto', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
  const onScroll = () => topo?.classList.toggle('is-rolado', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .topo {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .topo.is-rolado { border-color: #e4e0d6; box-shadow: 0 8px 24px -20px rgba(0, 61, 89, 0.5); }

  .topo__barra {
    display: flex; align-items: center; gap: clamp(0.75rem, 2vw, 2rem);
    min-height: 5.5rem;
  }
  .topo__marca { color: var(--petrol); flex: none; padding-block: 0.5rem; }
  .topo__marca :global(.marca) { height: clamp(1.5rem, 1.1rem + 0.9vw, 2.1rem); width: auto; }

  .topo__nav { margin-left: auto; }
  .topo__nav ul { display: flex; gap: clamp(1.1rem, 2vw, 2.5rem); list-style: none; margin: 0; padding: 0; }
  .topo__nav a {
    display: inline-block; padding-block: 0.5rem;
    font-size: 0.95rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap;
    color: var(--petrol-ink); text-decoration: none;
    background: linear-gradient(var(--yellow), var(--yellow)) left 100% / 0 2px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }
  .topo__nav a:hover { background-size: 100% 2px; }

  .topo__wa {
    display: inline-flex; align-items: center; justify-content: center; width: 3rem; height: 3rem;
    border: 2px solid var(--teal); border-radius: 50%;
    color: var(--teal-ink); font-weight: 700; font-size: 0.95rem; letter-spacing: 0.14em; text-transform: uppercase;
    text-decoration: none; flex: none;
  }
  .topo__wa:hover { color: var(--petrol); border-color: var(--petrol); background: rgba(26, 210, 147, 0.12); }
  .topo__wa-icone { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .topo__wa-icone .topo__wa-fone { fill: currentColor; stroke: none; }
  .topo__wa--movel { display: none; }
  .topo__cta { min-height: 3rem; padding-inline: 1.6rem; font-size: 0.95rem; white-space: nowrap; flex: none; }

  .topo__menu {
    display: none; margin-left: auto;
    align-items: center; gap: 0.6rem;
    min-height: 3rem; padding: 0.5rem 1rem;
    border: 2px solid var(--petrol); border-radius: var(--radius-pill);
    background: transparent; color: var(--petrol);
    font: 700 0.95rem/1 var(--font-text); letter-spacing: 0.14em; text-transform: uppercase;
    cursor: pointer;
  }
  .topo__menu-linhas, .topo__menu-linhas::before, .topo__menu-linhas::after {
    display: block; width: 1.1rem; height: 2px; background: currentColor; border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.2s;
  }
  .topo__menu-linhas { position: relative; }
  .topo__menu-linhas::before, .topo__menu-linhas::after { content: ''; position: absolute; left: 0; }
  .topo__menu-linhas::before { top: -6px; }
  .topo__menu-linhas::after { top: 6px; }
  .is-aberto .topo__menu-linhas { background: transparent; }
  .is-aberto .topo__menu-linhas::before { transform: translateY(6px) rotate(45deg); }
  .is-aberto .topo__menu-linhas::after { transform: translateY(-6px) rotate(-45deg); }

  .topo__movel { border-top: 1px solid #e4e0d6; background: var(--paper); }
  .topo__movel ul { list-style: none; margin: 0; padding-block: 1rem 1.75rem; display: grid; gap: 0.25rem; }
  .topo__movel a:not(.btn) {
    display: block; padding: 0.85rem 0;
    font-family: var(--font-display); font-size: 2.2rem; text-transform: uppercase; line-height: 1;
    color: var(--petrol); text-decoration: none;
    border-bottom: 1px solid #e4e0d6;
  }
  .topo__movel .btn { margin-top: 1rem; width: 100%; }

  @media (max-width: 76rem) {
    .topo__nav, .topo__cta, .topo__wa:not(.topo__wa--movel) { display: none; }
    .topo__menu { display: inline-flex; margin-left: 0; }
    .topo__wa--movel { display: inline-flex; margin-left: auto; }
    .topo__barra { min-height: 4.5rem; }
  }
</style>
