---
import Marca from './Marca.astro';
import { site, whatsappLink } from '../data/site';
import { unidades } from '../data/unidades';
const ano = new Date().getFullYear();
---
<footer class="rodape on-petrol">
  <div class="wrap rodape__grade">
    <div class="rodape__marca">
      <Marca tipo="simbolo" label={null} class="rodape__simbolo" />
      <Marca tipo="wordmark" class="rodape__wordmark" />
      <p class="rodape__desc">Escola Cultural 60+</p>
    </div>

    <nav aria-labelledby="rodape-escola">
      <h2 class="rodape__titulo" id="rodape-escola">A escola</h2>
      <ul class="rodape__lista">
        <li><a href="/#sobre">Sobre a CICLOS+</a></li>
        <li><a href="/disciplinas">Disciplinas semestrais</a></li>
        <li><a href="/aulas-livres">Aulas livres</a></li>
        <li><a href="/viagens-culturais">Viagens culturais</a></li>
        <li><a href="/confraternizacoes">Confraternizações</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="rodape__titulo"><a href="/unidades">Unidades</a></h2>
      <ul class="rodape__lista">
        {unidades.map((u) => {
          const fone = u.whatsapp ?? site.whatsapp;
          return (
            <li class="rodape__unidade">
              <a href={`/unidades/${u.slug}`}><strong>{u.cidade}</strong></a>
              <span class="rodape__end">{u.local ? `${u.local} · ` : ''}{u.endereco}</span>
              <a class="rodape__wa" href={whatsappLink(`Olá! Quero conhecer a CICLOS+ ${u.cidade}.`, fone.e164)} target="_blank" rel="noopener" aria-label={`WhatsApp da CICLOS+ ${u.cidade}: ${fone.display}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z" /><path d="M9.2 8.6c.2 2.6 2.2 4.9 4.9 5.6l1.2-1.3 1.9.9-.4 1.6c-3.8.3-7.9-3.6-8.3-7.4l1.6-.5.9 1.9z" class="rodape__wa-fone" /></svg>
                <span>{fone.display}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div>
      <h2 class="rodape__titulo">Contato</h2>
      <ul class="rodape__lista">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap rodape__base">
    <p>© {ano} CICLOS+. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .rodape {
    background: linear-gradient(rgba(0, 45, 66, 0.6), rgba(0, 45, 66, 0.6)), var(--petrol) var(--tex-petrol) center / 1200px auto repeat;
    color: var(--on-petrol-soft);
    padding-block: clamp(3.5rem, 6vw, 5.5rem) 2rem;
  }
  .rodape__grade {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 3rem;
  }
  .rodape__titulo a { color: inherit; text-decoration: none; }
  .rodape__titulo a:hover { color: var(--yellow); }
  .rodape__lista a strong { display: inline; }
  .rodape__lista a:has(strong) { color: var(--on-petrol); }
  .rodape__marca { color: var(--on-petrol); }
  .rodape__marca :global(.rodape__simbolo) { width: 5.5rem; color: var(--mint); margin-bottom: 1.5rem; }
  .rodape__marca :global(.rodape__wordmark) { width: 13rem; height: auto; }
  .rodape__desc { margin-top: 0.75rem; font-style: italic; }
  .rodape__titulo { font-size: 1.9rem; color: var(--on-petrol); margin-bottom: 1rem; }
  .rodape__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; font-size: 1.05rem; }
  .rodape__lista strong { display: block; color: var(--on-petrol); font-weight: 600; }
  .rodape__lista a { color: var(--on-petrol-soft); }
  .rodape__lista a:hover { color: var(--yellow); }
  .rodape__unidade { display: grid; gap: 0.3rem; justify-items: start; }
  .rodape__end { display: block; }
  .rodape__wa { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; }
  .rodape__wa svg { width: 1.4rem; height: 1.4rem; flex: none; fill: none; stroke: var(--mint); stroke-width: 1.8; stroke-linejoin: round; }
  .rodape__wa .rodape__wa-fone { fill: var(--mint); stroke: none; }
  .rodape__wa:hover svg { stroke: var(--yellow); }
  .rodape__wa:hover .rodape__wa-fone { fill: var(--yellow); }
  .rodape__base {
    margin-top: 3.5rem; padding-top: 1.5rem;
    position: relative;
    font-size: 0.95rem;
  }
  .rodape__base::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: rgba(199, 227, 234, 0.25); }
  @media (max-width: 64rem) { .rodape__grade { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 40rem) { .rodape__grade { grid-template-columns: 1fr; } }
</style>
