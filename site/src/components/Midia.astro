---
const materias = [
  { veiculo: 'RBS Notícias', titulo: 'O conceito de economia prateada', data: 'Novembro de 2024', href: 'https://www.cwaclipping.net/sistema/cliente/materia?security=fb96e8b8baff.14505627.26348625&rn=1' },
  { veiculo: 'GZH · Radar de Inovação', titulo: 'Educação 60+: iniciativas gaúchas para a terceira idade', data: 'Novembro de 2024', href: 'https://www.youtube.com/watch?v=5V0D00ny_BM' },
  { veiculo: 'Record Guaíba', titulo: 'Conversando Negócios', data: '2024', href: 'https://www.youtube.com/watch?v=ACB5VLfcn2M' },
  { veiculo: 'Band RS', titulo: 'Entre Amigos', data: 'Janeiro de 2024', href: 'https://www.youtube.com/watch?v=DnZOF0InLU8' },
];
---
<section class="midia" aria-labelledby="midia-titulo">
  <div class="wrap">
    <h2 id="midia-titulo" class="midia__titulo">CICLOS+ na mídia</h2>
    <ul class="midia__lista">
      {materias.map((m) => (
        <li>
          <a href={m.href} target="_blank" rel="noopener">
            <span class="midia__veiculo">{m.veiculo}</span>
            <span class="midia__materia">{m.titulo}</span>
            <span class="midia__data">{m.data}</span>
            <svg class="midia__seta" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8" /></svg>
            <span class="visually-hidden">(abre em nova aba)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .midia { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .midia__titulo { font-size: clamp(2.75rem, 1.8rem + 3vw, 5rem); color: var(--petrol); }
  .midia__lista { list-style: none; margin: 2.5rem 0 0; padding: 0; border-top: 2px solid var(--petrol); }
  .midia__lista a {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 2fr) 2rem;
    gap: 0.5rem 2rem; align-items: center;
    padding: 1.4rem 0.25rem; border-bottom: 1px solid #d9d4c7;
    text-decoration: none; color: var(--ink);
    transition: background-color 0.3s;
  }
  .midia__lista a:hover { background: rgba(26, 210, 147, 0.12); }
  .midia__veiculo { font-family: var(--font-display); text-transform: uppercase; font-size: 2rem; line-height: 1; color: var(--teal-ink); }
  .midia__materia { font-weight: 600; }
  .midia__data { font-style: italic; color: var(--ink-soft); }
  .midia__seta { width: 1.6rem; fill: none; stroke: var(--petrol); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.4s var(--ease-out); }
  .midia__lista a:hover .midia__seta { transform: translate(3px, -3px); }

  @media (max-width: 52rem) {
    .midia__lista a { grid-template-columns: 1fr 2rem; }
    .midia__veiculo, .midia__materia, .midia__data { grid-column: 1; }
    .midia__seta { grid-column: 2; grid-row: 1 / 4; }
  }
</style>
