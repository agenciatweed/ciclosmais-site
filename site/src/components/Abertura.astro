---
// Abertura das páginas internas: trilha, título, voz, texto e uma foto recortada numa forma da marca.
import { Image } from 'astro:assets';
import Trilha from './Trilha.astro';
import Marca from './Marca.astro';
import type { Foto } from '../data/disciplinas';

interface Props {
  titulo: string;
  sobretitulo?: string;
  voz: string;
  trilha: { href: string; label: string }[];
  foto?: Foto;
  posicao?: string;
  forma?: 'arco' | 'circulo' | 'eliptico';
  anel?: 'menta' | 'amarelo' | 'papel';
  campo?: 'papel' | 'menta';
}
const { titulo, sobretitulo, voz, trilha, foto, posicao = foto?.pos ?? '50% 50%', forma = 'arco', anel = 'menta', campo = 'papel' } = Astro.props;
const legenda = foto ? [foto.legenda, foto.ilustrativa ? 'Imagem ilustrativa.' : ''].filter(Boolean).join(' ') : '';
---
<section class:list={['abertura', `abertura--${campo}`, { 'abertura--sem-foto': !foto }]} aria-labelledby="pagina-titulo">
  {campo === 'menta' && <Marca tipo="simbolo" label={null} class="abertura__marca" />}
  <div class="wrap abertura__grade">
    <div class="abertura__texto">
      <Trilha itens={trilha} tom={campo} />
      {sobretitulo && <p class="abertura__sobre">{sobretitulo}</p>}
      <h1 id="pagina-titulo" class="abertura__titulo">{titulo}</h1>
      <p class="abertura__voz">{voz}</p>
      <div class="abertura__corpo"><slot /></div>
      <div class="abertura__acoes"><slot name="acoes" /></div>
    </div>

    {foto ? (
      <figure class:list={['abertura__foto', `abertura__foto--${forma}`, `abertura__foto--${anel}`]}>
        <Image src={foto.src} alt={foto.alt} widths={[420, 640, 900, 1200]} sizes="(max-width: 56rem) 90vw, 40vw" loading="eager" fetchpriority="high" style={`object-position:${posicao}`} />
        {legenda && <figcaption>{legenda}</figcaption>}
      </figure>
    ) : (
      <div class="abertura__simbolo" aria-hidden="true"><Marca tipo="simbolo" label={null} /></div>
    )}
  </div>
</section>

<style>
  .abertura { position: relative; overflow: clip; padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(4rem, 8vw, 7rem); }
  .abertura--menta { background: var(--mint); color: var(--petrol-ink); }
  .abertura :global(.abertura__marca) {
    position: absolute; right: -8rem; top: -7rem; width: min(36rem, 60vw);
    color: #2fe0a2; pointer-events: none;
  }

  .abertura__grade {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 6rem); align-items: center;
  }
  .abertura__simbolo { justify-self: center; width: min(100%, 26rem); color: var(--mint); }
  .abertura__simbolo :global(.marca) { width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .abertura__simbolo { animation: girar-abertura 1.8s var(--ease-out) both; }
  }
  @keyframes girar-abertura { from { transform: rotate(-120deg) scale(0.92); } to { transform: none; } }

  .abertura__sobre {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700; font-size: 0.95rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--teal-ink);
  }
  .abertura__titulo {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-size: clamp(3.5rem, 1.6rem + 5.4vw, 7.5rem); line-height: 0.88;
    color: var(--petrol);
  }
  .abertura__sobre + .abertura__titulo { margin-top: 0.6rem; }
  .abertura__voz {
    margin-top: clamp(1rem, 1.8vw, 1.5rem); max-width: 26ch;
    font-style: italic; font-size: clamp(1.35rem, 1rem + 0.9vw, 1.85rem); line-height: 1.28;
    color: var(--teal-ink);
  }
  .abertura__corpo { margin-top: 1.25rem; max-width: 46ch; display: grid; gap: 1rem; }
  .abertura__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: clamp(1.75rem, 2.6vw, 2.25rem); }
  .abertura__acoes:empty { display: none; }

  .abertura--menta .abertura__titulo { color: var(--petrol-ink); }
  .abertura--menta .abertura__voz { color: var(--petrol); font-weight: 700; }
  .abertura--menta .abertura__sobre { color: var(--petrol-ink); }
  .abertura--menta :global(.link-arrow) { color: var(--petrol-ink); }

  .abertura__foto { margin: 0; position: relative; justify-self: end; width: 100%; max-width: 34rem; }
  .abertura__foto :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    box-shadow: 0 30px 60px -40px rgba(0, 61, 89, 0.6);
    background: var(--paper-2);
  }
  .abertura__foto--arco :global(img) { border-radius: 999px 999px 1.5rem 1.5rem; }
  .abertura__foto--eliptico :global(img) { border-radius: 50% 50% 1.25rem 1.25rem / 36% 36% 1.25rem 1.25rem; aspect-ratio: 3 / 4; }
  .abertura__foto--circulo :global(img) { border-radius: 50%; aspect-ratio: 1; }
  .abertura__foto--menta :global(img) { border: 8px solid var(--mint); }
  .abertura__foto--amarelo :global(img) { border: 8px solid var(--yellow); }
  .abertura__foto--papel :global(img) { border: 8px solid var(--paper); }
  .abertura__foto figcaption { margin-top: 0.9rem; font-style: italic; font-size: 1rem; color: var(--ink-soft); }
  .abertura--menta .abertura__foto figcaption { color: var(--petrol-ink); }

  @media (max-width: 56rem) {
    .abertura__grade { grid-template-columns: 1fr; }
    .abertura__foto { justify-self: start; max-width: 28rem; }
    .abertura__simbolo { display: none; }
  }
</style>
