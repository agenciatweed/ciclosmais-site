---
// Galeria de fotos reais em colunas, respeitando a proporção de cada foto.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string;
  titulo: string;
  voz?: string;
  fotos: { src: ImageMetadata; alt: string; pos?: string }[];
  nota?: string;
}
const { id = 'galeria', titulo, voz, fotos, nota } = Astro.props;
---
<section class="galeria" aria-labelledby={`${id}-titulo`}>
  <div class="wrap">
    <div class="galeria__topo">
      <h2 id={`${id}-titulo`} class="galeria__titulo">{titulo}</h2>
      {voz && <p class="galeria__voz">{voz}</p>}
    </div>
    <ul class="galeria__fotos">
      {fotos.map((f) => (
        <li>
          <Image src={f.src} alt={f.alt} widths={[360, 560, 800]} sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 30vw" style={f.pos ? `object-position:${f.pos}` : undefined} />
        </li>
      ))}
    </ul>
    {nota && <p class="galeria__nota">{nota}</p>}
  </div>
</section>

<style>
  .galeria { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .galeria__topo { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 3rem; }
  .galeria__titulo { font-size: clamp(2.75rem, 1.8rem + 3vw, 5rem); color: var(--petrol); max-width: 16ch; }
  .galeria__voz { font-style: italic; color: var(--teal-ink); font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.6rem); line-height: 1.3; max-width: 28ch; }

  .galeria__fotos {
    list-style: none; margin: clamp(2.5rem, 5vw, 3.5rem) 0 0; padding: 0;
    columns: 3; column-gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .galeria__fotos li { break-inside: avoid; margin-bottom: clamp(0.75rem, 1.4vw, 1.25rem); }
  .galeria__fotos :global(img) {
    width: 100%; height: auto; border-radius: 1.25rem; background: var(--paper-2);
    box-shadow: 0 24px 48px -36px rgba(0, 61, 89, 0.6);
  }
  .galeria__fotos li:first-child :global(img) { border-radius: 999px 999px 1.25rem 1.25rem; }
  .galeria__nota { margin-top: 1.5rem; font-style: italic; color: var(--ink-soft); font-size: 1rem; }

  @media (max-width: 64rem) { .galeria__fotos { columns: 2; } }
  @media (max-width: 40rem) { .galeria__fotos { columns: 1; } }
</style>
