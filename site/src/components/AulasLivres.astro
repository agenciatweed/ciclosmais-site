---
import { Image } from 'astro:assets';
import xadrez from '../assets/img/Cursos Livres - 02.jpg';
import verao from '../assets/img/Cursos Livres - IMG_77551-scaled.jpg';
import palestra from '../assets/img/Cursos Livres - 09.jpg';
import { aulasLivres, futuras } from '../data/agenda';
import { unidadePorSlug } from '../data/unidades';

// Uma linha com os assuntos das próximas aulas livres, por unidade.
const proximas = [...new Set(aulasLivres.filter((a) => futuras(a.datas).length).map((a) => a.unidade))].map((slug) => {
  const assuntos = [...new Set(aulasLivres.filter((a) => a.unidade === slug && futuras(a.datas).length).map((a) => a.assunto))];
  return { cidade: unidadePorSlug(slug)?.cidade, lista: `${assuntos.slice(0, -1).join(', ')}${assuntos.length > 1 ? ' e ' : ''}${assuntos.at(-1)}` };
});
---
<section class="livres" id="aulas-livres" aria-labelledby="livres-titulo">
  <div class="wrap livres__grade">
    <div class="livres__texto">
      <h2 id="livres-titulo" class="livres__titulo">Aulas livres</h2>
      <p class="livres__voz">O aprendizado nunca tem idade para começar ou recomeçar.</p>
      <p>
        Aulas avulsas, em poucos encontros, para experimentar um assunto novo sem compromisso de semestre.
        A abordagem é integrativa e acolhedora, no ritmo e nos interesses de cada aluno.
      </p>
      {proximas.map((p) => (
        <p class="livres__agenda"><strong>Próximas em {p.cidade}:</strong> {p.lista}.</p>
      ))}
      <div class="livres__acoes">
        <a class="btn" href="/aulas-livres">Ver as próximas aulas livres</a>
        <a class="link-arrow" href="#quero-conhecer">Quero receber a programação</a>
      </div>
    </div>

    <div class="livres__fotos">
      <Image class="livres__f1" src={xadrez} alt="Alunos jogando xadrez durante uma aula livre, com a professora ao fundo" widths={[360, 560, 760]} sizes="(max-width: 56rem) 60vw, 26vw" />
      <Image class="livres__f2" src={verao} alt="Turma assiste a uma apresentação do Ciclo Verão num espaço com sofás" widths={[320, 480, 640]} sizes="(max-width: 56rem) 45vw, 20vw" />
      <Image class="livres__f3" src={palestra} alt="Professor apresenta conteúdo projetado para alunos atentos" widths={[320, 480, 640]} sizes="(max-width: 56rem) 45vw, 18vw" />
    </div>
  </div>
</section>

<style>
  .livres { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .livres__grade {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem); align-items: center;
  }
  .livres__titulo { font-size: clamp(3.25rem, 2rem + 4vw, 6.5rem); color: var(--petrol); }
  .livres__voz {
    margin: 1.25rem 0 1.25rem; font-style: italic; color: var(--teal-ink);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.85rem); line-height: 1.3; max-width: 24ch;
  }
  .livres__texto p:not(.livres__voz) { max-width: 44ch; margin-bottom: 1.75rem; }
  .livres__agenda { margin-top: -0.75rem; margin-bottom: 1.75rem; color: var(--petrol-ink); }
  .livres__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }

  .livres__fotos {
    position: relative;
    display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(10, minmax(0, 3.2rem));
  }
  .livres__fotos :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    box-shadow: 0 24px 48px -30px rgba(0, 61, 89, 0.55);
  }
  .livres__fotos :global(.livres__f1) { grid-column: 1 / 10; grid-row: 1 / 9; border-radius: 1.5rem; }
  .livres__fotos :global(.livres__f2) {
    grid-column: 7 / 13; grid-row: 5 / 11; border-radius: 50%; aspect-ratio: 1; height: auto; align-self: end;
    border: 8px solid var(--mint); z-index: 1;
  }
  .livres__fotos :global(.livres__f3) { grid-column: 1 / 7; grid-row: 8 / 11; border-radius: 1.25rem; border: 6px solid var(--paper); }

  @media (max-width: 56rem) {
    .livres__grade { grid-template-columns: 1fr; }
    .livres__fotos { grid-template-rows: repeat(10, minmax(0, 2.4rem)); }
  }
</style>
