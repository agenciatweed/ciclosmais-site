---
import Marca from './Marca.astro';
import { site, whatsappLink } from '../data/site';
import { unidades } from '../data/unidades';
import { disciplinas } from '../data/disciplinas';

const assuntos = [...disciplinas.map((d) => d.nome), 'Cursos livres', 'Viagens culturais'];
---
<section class="qc" id="quero-conhecer" aria-labelledby="qc-titulo">
  <Marca tipo="simbolo" label={null} class="qc__marca" />
  <div class="wrap qc__grade">
    <div class="qc__texto">
      <h2 id="qc-titulo" class="qc__titulo">Quero conhecer a CICLOS+</h2>
      <p class="qc__voz">Conte um pouco sobre você e entramos em contato para apresentar a escola.</p>
      <p>{site.formEndpoint ? 'Retornamos em até 24 horas. Se preferir, fale agora com a gente:' : 'Ao enviar, a conversa continua no WhatsApp com uma pessoa da equipe. Se preferir, fale direto:'}</p>
      <ul class="qc__contatos">
        <li><a href={whatsappLink('Olá! Quero conhecer a CICLOS+.')} target="_blank" rel="noopener">WhatsApp {site.whatsapp.display}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>

    <form class="form" id="form-qc" novalidate data-endpoint={site.formEndpoint} data-whatsapp={site.whatsapp.e164}>
      <div class="campo">
        <label for="qc-nome">Seu nome</label>
        <input id="qc-nome" name="nome" type="text" autocomplete="name" required placeholder="Ex.: Maria" />
        <p class="campo__erro" id="qc-nome-erro" hidden>Escreva seu nome para sabermos como chamar você.</p>
      </div>

      <div class="campo">
        <label for="qc-tel">WhatsApp ou telefone</label>
        <input id="qc-tel" name="telefone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="(51) 99999-9999" />
        <p class="campo__erro" id="qc-tel-erro" hidden>Coloque um número com DDD, por exemplo (51) 99999-9999.</p>
      </div>

      <fieldset class="campo campo--opcoes">
        <legend>Qual unidade?</legend>
        <div class="opcoes">
          {unidades.map((u, i) => (
            <label class="opcao"><input type="radio" name="unidade" value={u.cidade} checked={i === 0} /><span>{u.cidade}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="campo campo--opcoes">
        <legend>Que assuntos interessam você? <span class="opcional">(opcional)</span></legend>
        <div class="opcoes opcoes--chips">
          {assuntos.map((a) => (
            <label class="opcao opcao--chip"><input type="checkbox" name="assuntos" value={a} /><span>{a}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="campo campo--opcoes">
        <legend>O interesse é</legend>
        <div class="opcoes">
          <label class="opcao"><input type="radio" name="para" value="Para mim" checked /><span>Para mim</span></label>
          <label class="opcao"><input type="radio" name="para" value="Para convidar ou presentear alguém" /><span>Para convidar ou presentear alguém</span></label>
        </div>
      </fieldset>

      <label class="aceite">
        <input type="checkbox" name="aceite" />
        <span>Aceito receber contato da CICLOS+ pelo WhatsApp.</span>
      </label>

      <button class="btn form__enviar" type="submit">Quero conhecer</button>
      <p class="form__status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('form-qc') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const botao = form.querySelector<HTMLButtonElement>('.form__enviar')!;
    const nome = form.querySelector<HTMLInputElement>('#qc-nome')!;
    const tel = form.querySelector<HTMLInputElement>('#qc-tel')!;

    const marcarErro = (input: HTMLInputElement, erro: boolean) => {
      const msg = document.getElementById(`${input.id}-erro`);
      input.setAttribute('aria-invalid', String(erro));
      if (erro) input.setAttribute('aria-describedby', `${input.id}-erro`); else input.removeAttribute('aria-describedby');
      if (msg) msg.hidden = !erro;
    };
    const valido = () => {
      const okNome = nome.value.trim().length >= 2;
      const okTel = tel.value.replace(/\D/g, '').length >= 10;
      marcarErro(nome, !okNome);
      marcarErro(tel, !okTel);
      if (!okNome) nome.focus(); else if (!okTel) tel.focus();
      return okNome && okTel;
    };
    [nome, tel].forEach((i) => i.addEventListener('input', () => { if (i.getAttribute('aria-invalid') === 'true') marcarErro(i, false); }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!valido()) { status.textContent = 'Confira os campos destacados.'; return; }
      const dados = new FormData(form);
      const payload = {
        nome: String(dados.get('nome')).trim(),
        telefone: String(dados.get('telefone')).trim(),
        unidade: String(dados.get('unidade')),
        assuntos: dados.getAll('assuntos').map(String),
        para: String(dados.get('para')),
        aceiteWhatsapp: dados.get('aceite') === 'on',
        origem: new URLSearchParams(location.search).get('utm_source') || 'site',
      };
      const endpoint = form.dataset.endpoint;
      botao.disabled = true; botao.textContent = 'Enviando…';
      try {
        if (endpoint) {
          const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (!r.ok) throw new Error(String(r.status));
          form.classList.add('is-enviado');
          status.textContent = `Obrigado, ${payload.nome.split(' ')[0]}! Recebemos seu contato e retornamos em até 24 horas.`;
        } else {
          // Sem destino configurado, a conversa segue pelo WhatsApp com a mensagem pronta.
          const texto = `Olá! Sou ${payload.nome} e quero conhecer a CICLOS+ ${payload.unidade}.` +
            (payload.assuntos.length ? ` Tenho interesse em: ${payload.assuntos.join(', ')}.` : '') +
            (payload.para !== 'Para mim' ? ` É para convidar ou presentear alguém.` : '') +
            ` Meu telefone: ${payload.telefone}.`;
          window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
          status.textContent = 'Abrimos o WhatsApp com sua mensagem pronta. É só enviar.';
        }
      } catch {
        status.textContent = 'Não conseguimos enviar agora. Tente de novo ou chame a gente no WhatsApp.';
      } finally {
        botao.disabled = false; botao.textContent = 'Quero conhecer';
      }
    });
  }
</script>

<style>
  .qc {
    position: relative; overflow: clip;
    background: var(--yellow);
    color: var(--petrol-ink);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .qc :global(.qc__marca) {
    position: absolute; left: -9rem; bottom: -10rem; width: min(36rem, 70vw);
    color: #f7cf55; pointer-events: none;
  }
  .qc__grade {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 6rem); align-items: start;
  }
  .qc__titulo { font-size: clamp(3.25rem, 1.8rem + 4.6vw, 7rem); color: var(--petrol); max-width: 10ch; }
  .qc__voz { margin: 1.25rem 0; font-style: italic; font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem); line-height: 1.3; max-width: 26ch; }
  .qc__contatos { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; font-weight: 700; }
  .qc__contatos a { color: var(--petrol); }

  .form {
    background: var(--paper) var(--tex-paper) 0 0 / 1800px auto;
    border-radius: 1.75rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    box-shadow: 0 30px 60px -40px rgba(80, 60, 0, 0.55);
    display: grid; gap: 1.5rem;
    color: var(--ink);
  }
  .campo { display: grid; gap: 0.5rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  .campo label, .campo legend { font-weight: 700; font-size: 1.1rem; color: var(--petrol-ink); padding: 0; }
  .opcional { font-weight: 400; font-style: italic; color: var(--ink-soft); }
  .campo input[type='text'], .campo input[type='tel'] {
    width: 100%; min-height: 3.5rem;
    padding: 0.75rem 1rem;
    border: 2px solid #b9c7cc; border-radius: 0.9rem;
    background: #fff; color: var(--ink);
    font: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .campo input::placeholder { color: #6a7f89; }
  .campo input:hover { border-color: var(--teal); }
  .campo input:focus-visible { outline: 3px solid var(--petrol); outline-offset: 1px; border-color: var(--petrol); }
  .campo input[aria-invalid='true'] { border-color: #b3261e; }
  .campo__erro { color: #9b1c14; font-size: 1rem; }

  .campo--opcoes legend { margin-bottom: 0.6rem; }
  .opcoes { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .opcao { position: relative; cursor: pointer; }
  .opcao input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opcao span {
    display: inline-flex; align-items: center; min-height: 3rem;
    padding: 0.55rem 1.2rem;
    border: 2px solid #b9c7cc; border-radius: var(--radius-pill);
    background: #fff; font-size: 1.05rem;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .opcao:hover span { border-color: var(--teal); }
  .opcao input:checked + span { background: var(--petrol); border-color: var(--petrol); color: #fff; }
  .opcao input:focus-visible + span { outline: 3px solid var(--petrol); outline-offset: 2px; }
  .opcao--chip span { min-height: 2.75rem; font-size: 1rem; }

  .aceite { display: flex; gap: 0.75rem; align-items: start; font-size: 1.05rem; cursor: pointer; }
  .aceite input { width: 1.4rem; height: 1.4rem; margin-top: 0.2rem; accent-color: var(--petrol); flex: none; }

  .form__enviar { width: 100%; background: var(--petrol); color: #fff; font-size: 1.15rem; min-height: 3.75rem; }
  .form__enviar:hover { background: var(--petrol-deep); }
  .form__enviar:disabled { opacity: 0.7; cursor: progress; transform: none; }
  .form__status { min-height: 1.5rem; font-weight: 600; color: var(--petrol-ink); }

  @media (max-width: 60rem) { .qc__grade { grid-template-columns: 1fr; } }
</style>
