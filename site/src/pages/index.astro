---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Disciplinas from '../components/Disciplinas.astro';
import CursosLivres from '../components/CursosLivres.astro';
import Encontros from '../components/Encontros.astro';
import Viagens from '../components/Viagens.astro';
import Equipe from '../components/Equipe.astro';
import Unidades from '../components/Unidades.astro';
import Midia from '../components/Midia.astro';
import QueroConhecer from '../components/QueroConhecer.astro';
---
<Base
  title="CICLOS+ · Escola Cultural 60+ em Porto Alegre e Pelotas"
  description="Escola cultural para pessoas 60+: arte, filosofia, cinema, história e música, sem provas e sem pressão. Aulas semanais, cursos livres, viagens culturais e confraternizações."
>
  <Hero />
  <Sobre />
  <Disciplinas />
  <CursosLivres />
  <Encontros />
  <Viagens />
  <Equipe />
  <Unidades />
  <Midia />
  <QueroConhecer />
</Base>
