---
// Landing page da Masterclass de Pelotas: primeira etapa do funil
// (Masterclass → aulas livres de novembro a janeiro → disciplinas semestrais 2027).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marca from '../components/Marca.astro';
import InscricaoEvento from '../components/InscricaoEvento.astro';
import { masterclassPelotas as ev } from '../data/eventos';
import { unidadePorSlug } from '../data/unidades';
import { disciplinas } from '../data/disciplinas';
import { site, whatsappLink } from '../data/site';
import { aulasLivres, matriculasPelotas, periodo } from '../data/agenda';
// Os três momentos do evento usam imagens ilustrativas geradas no Magnific (escolha da cliente);
// os quatro atos e a faixa usam obras barrocas em domínio público, da apresentação da masterclass.
import abertura from '../assets/img/geradas/masterclass-abertura.jpg';
import aulaImg from '../assets/img/geradas/masterclass-aula.jpg';
import degustacao from '../assets/img/geradas/masterclass-degustacao.jpg';
import pozzo from '../assets/img/obras/pozzo-apoteose-de-santo-inacio.jpg';
import vocacao from '../assets/img/obras/caravaggio-vocacao-de-sao-mateus.jpg';
import baco from '../assets/img/obras/caravaggio-baco.jpg';
import captura from '../assets/img/obras/caravaggio-captura-de-cristo.jpg';
import davi from '../assets/img/obras/caravaggio-davi-com-a-cabeca-de-golias.jpg';
import fotoAula from '../assets/img/Disciplinas Semestrais - IMG_9955-scaled.jpg';
import fotoFesta from '../assets/img/Confraternizacoes - 3ed0acf4fd23.jpg';
import fotoViagem from '../assets/img/Viagens Culturais - IMG-20250608-WA0031.jpg';

const u = unidadePorSlug(ev.unidade)!;
const wa = whatsappLink(`Olá! Quero saber da masterclass "${ev.titulo}" na CICLOS+ ${u.cidade}.`, u.whatsapp?.e164);
const fone = u.whatsapp?.display ?? site.whatsapp.display;

const fatos = [
  { termo: 'Quando', texto: `${ev.quando}, ${ev.horario}` },
  { termo: 'Onde', texto: `${ev.local!.nome}, ${ev.local!.endereco}, ${ev.local!.cidade}` },
  { termo: 'O que', texto: 'Aula de cerca de 40 minutos + degustação e harmonização de vinhos' },
  { termo: 'Investimento', texto: `${ev.valor!.texto} por pessoa, com aula, degustação e harmonização` },
];

// Os quatro atos da aula, com frases e obras da apresentação da masterclass.
const atos = [
  { n: 1, nome: 'A Luz', tema: 'O instante em que algo se revela', frase: 'Começamos pela luz. Antes da sombra, existe o contraste.', obra: vocacao, legenda: 'A vocação de São Mateus, 1599–1600', alt: 'Pintura de Caravaggio: um feixe de luz atravessa uma sala escura e ilumina homens sentados à mesa enquanto Cristo aponta para Mateus', pos: '50% 40%' },
  { n: 2, nome: 'O Desejo', tema: 'Prazer, matéria e proximidade', frase: 'Caravaggio pinta o sagrado e o profano com a mesma carne.', obra: baco, legenda: 'Baco, 1596', alt: 'Pintura de Caravaggio: o deus Baco, coroado de folhas de uva, oferece uma taça de vinho tinto', pos: '50% 30%' },
  { n: 3, nome: 'A Sombra', tema: 'Violência, silêncio e dúvida', frase: 'Na sombra, Caravaggio guarda aquilo que não revela completamente.', obra: captura, legenda: 'A captura de Cristo, 1602', alt: 'Pintura de Caravaggio: soldados de armadura agarram Cristo na escuridão, iluminados por uma luz lateral', pos: '40% 40%' },
  { n: 4, nome: 'A Redenção', tema: 'Culpa, compaixão e humanidade', frase: 'Depois da luz e da sombra, resta a humanidade.', obra: davi, legenda: 'Davi com a cabeça de Golias, 1610', alt: 'Pintura de Caravaggio: o jovem Davi, de expressão melancólica, segura a cabeça de Golias', pos: '50% 30%' },
];

const paraQuem = [
  { termo: 'Sem pré-requisito', texto: 'A aula foi pensada para quem tem curiosidade, não para especialistas.' },
  { termo: 'Conversa de verdade', texto: 'Perguntar, comentar e trocar impressões faz parte da aula.' },
  { termo: 'Boa companhia', texto: 'Gente da cidade que também gosta de cultura, de vinho e de um bom papo.' },
  { termo: 'Numa quinta à noite', texto: `${ev.quando}, ${ev.horario}, no ${ev.local!.nome}.` },
];

const assuntosLivres = [...new Set(aulasLivres.filter((a) => a.unidade === ev.unidade).map((a) => a.assunto))];
const listaAssuntos = `${assuntosLivres.slice(0, -1).join(', ')} e ${assuntosLivres.at(-1)}`;
const caminho = [
  { quando: '5 de novembro', titulo: 'Masterclass', texto: 'Arte, Sabores e Sentidos: o primeiro encontro com a CICLOS+.', atual: true },
  { quando: 'Novembro a janeiro', titulo: 'Aulas livres', texto: `Aulas de ${listaAssuntos}, para experimentar os assuntos da escola, um de cada vez.` },
  { quando: 'Março de 2027', titulo: 'Disciplinas semestrais', texto: `As aulas começam em 1º de março. Matrículas em ${matriculasPelotas.periodos.map(periodo).join(', ').replace(/, ([^,]*)$/, ' e $1')}.` },
];

const perguntas = [
  { p: 'Sobre o que é a aula?', r: 'Sobre Caravaggio e o Barroco: a vida do pintor e as suas obras em quatro atos (a luz, o desejo, a sombra e a redenção), com um olhar também para Rubens, Velázquez e Ribera.' },
  { p: 'Preciso entender de arte ou de vinho?', r: 'Não. A aula parte do zero e foi pensada para quem tem curiosidade. A sommelier conduz a degustação passo a passo.' },
  { p: 'Quanto tempo dura?', r: `O encontro vai ${ev.horario}. Primeiro, a aula de História da Arte, de cerca de 40 minutos; em seguida, a degustação de vinhos com a sommelier.` },
  { p: 'Onde é?', r: `No ${ev.local!.nome}: ${ev.local!.endereco}, ${ev.local!.cidade}/${ev.local!.uf}.` },
  { p: 'Quanto custa?', r: `${ev.valor!.texto} por pessoa. Está incluído o encontro completo: a aula sobre Caravaggio e a degustação e harmonização de vinhos com a sommelier.` },
  { p: 'Como confirmo minha inscrição?', r: 'Preencha o formulário desta página. A equipe da CICLOS+ Pelotas confirma seu lugar pelo WhatsApp.' },
  { p: 'O que acontece depois da masterclass?', r: `Quem participa recebe em primeira mão a programação das aulas livres de novembro a janeiro (${listaAssuntos}), uma forma leve de conhecer outros assuntos antes das disciplinas de 2027.` },
];

// Dados estruturados do evento (Google: resultados de evento).
const ld = {
  '@context': 'https://schema.org',
  '@type': 'EducationEvent',
  name: `${ev.titulo} · ${ev.tipo}`,
  description: ev.resumo,
  startDate: ev.inicio,
  endDate: ev.fim,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: 'pt-BR',
  location: {
    '@type': 'Place',
    name: ev.local!.nome,
    address: { '@type': 'PostalAddress', streetAddress: ev.local!.endereco, addressLocality: ev.local!.cidade, addressRegion: ev.local!.uf, addressCountry: 'BR' },
  },
  offers: {
    '@type': 'Offer',
    price: ev.valor!.numero,
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: new URL('/masterclass', Astro.site).href,
    validFrom: '2026-10-21',
  },
  organizer: { '@type': 'Organization', name: 'CICLOS+ Escola Cultural 60+', url: 'https://ciclosmais.com' },
  image: [new URL(abertura.src, Astro.site).href],
};
---
<Base
  title={`Masterclass ${ev.titulo} · CICLOS+ ${u.cidade}`}
  description={`${ev.voz} ${ev.quando}, ${ev.horario}, no ${ev.local!.nome}, em ${u.cidade}. ${ev.valor!.texto}. Reserve seu lugar.`}
  imagem={abertura}
  formNaPagina={false}
  landing={{ href: '#inscricao', texto: 'Reservar meu lugar', whatsappTexto: `Olá! Quero saber da masterclass "${ev.titulo}" na CICLOS+ ${u.cidade}.` }}
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="mc-hero" aria-labelledby="mc-titulo">
    <Marca tipo="simbolo" label={null} class="mc-hero__marca" />
    <div class="wrap mc-hero__grade">
      <div class="mc-hero__texto">
        <p class="mc-hero__tipo">{ev.tipo}</p>
        <h1 id="mc-titulo" class="mc-hero__titulo">{ev.titulo}</h1>
        {ev.subtitulo && <p class="mc-hero__sub">{ev.subtitulo}</p>}
        <p class="mc-hero__voz">{ev.voz}</p>
        <dl class="mc-fatos">
          {fatos.map((f) => <div><dt>{f.termo}</dt><dd>{f.texto}</dd></div>)}
        </dl>
        <div class="mc-hero__acoes">
          <a class="link-arrow" href="#a-noite">Como vai ser a noite</a>
          <a class="link-arrow" href={ev.local!.mapa} target="_blank" rel="noopener">Como chegar</a>
          <a class="link-arrow" href={wa} target="_blank" rel="noopener">Dúvidas? WhatsApp {fone}</a>
        </div>
      </div>

      <figure class="mc-hero__foto">
        <Image src={abertura} alt="Grupo de pessoas 60+ com taças de vinho tinto observa, encantado, uma pintura de Caravaggio projetada na parede" widths={[480, 720, 1000, 1448]} sizes="(max-width: 60rem) 92vw, 52vw" loading="eager" fetchpriority="high" />
        <figcaption>Imagem ilustrativa.</figcaption>
      </figure>

      <div class="mc-hero__form" id="inscricao">
        <InscricaoEvento evento={ev} />
      </div>
    </div>
  </section>

  <section class="secao mc-noite" id="a-noite" aria-labelledby="noite-titulo">
    <div class="wrap">
      <h2 id="noite-titulo" class="secao__titulo">A noite em dois tempos</h2>
      <p class="secao__voz">Primeiro, os olhos. Depois, o paladar. No meio, muita conversa.</p>

      <div class="tempo">
        <figure class="tempo__foto tempo__foto--arco">
          <Image src={aulaImg} alt="Professora aponta para o Baco de Caravaggio projetado na parede, diante de alunos 60+ encantados" widths={[400, 640, 880, 1200]} sizes="(max-width: 56rem) 90vw, 36vw" />
          <figcaption>Imagem ilustrativa.</figcaption>
        </figure>
        <div class="tempo__texto">
          <p class="tempo__num">1 · cerca de 40 minutos</p>
          <h3 class="tempo__titulo">A aula: Caravaggio de perto</h3>
          <p>
            Michelangelo Merisi, o Caravaggio, revolucionou a pintura com luz e sombra. Em 1600, as telas da
            Capela Contarelli, em Roma, fizeram dele o pintor mais comentado da cidade. Em 1606, depois de um duelo,
            passou a viver em fuga, entre Nápoles, Malta e a Sicília. Morreu aos 38 anos, e o perdão do Papa
            só chegou dez dias depois.
          </p>
          <p>
            Numa aula de História da Arte da CICLOS+, a vida e a obra dele são contadas em quatro atos, com um olhar
            também para o Barroco de Rubens, Velázquez e Ribera. Sem decoreba e sem prova.
          </p>
        </div>
      </div>

      <div class="tempo tempo--inverso">
        <figure class="tempo__foto tempo__foto--circulo">
          <Image src={degustacao} alt="Sommelier serve vinho tinto a convidados 60+ que riem e brindam numa mesa à luz de velas" widths={[400, 640, 880]} sizes="(max-width: 56rem) 90vw, 36vw" />
          <figcaption>Imagem ilustrativa.</figcaption>
        </figure>
        <div class="tempo__texto">
          <p class="tempo__num">2 · degustação com sommelier</p>
          <h3 class="tempo__titulo">A degustação: a arte também se prova</h3>
          <p>
            Depois da aula, a conversa continua à mesa. Uma sommelier conduz a degustação e a harmonização de vinhos, que percorrem
            os mesmos quatro atos da aula, agora na taça: aromas, cores e sabores também contam histórias.
          </p>
          <p>É o momento de brindar, comparar impressões e conhecer quem também estava ali pela curiosidade.</p>
        </div>
      </div>

      <a class="btn mc-noite__cta" href="#inscricao">Quero reservar meu lugar</a>
    </div>
  </section>

  <section class="secao secao--petroleo atos-sec" aria-labelledby="atos-titulo">
    <div class="wrap">
      <h2 id="atos-titulo" class="secao__titulo">Caravaggio em quatro atos</h2>
      <p class="secao__voz">Da luz à redenção: a aula e a degustação seguem o mesmo roteiro.</p>
      <ol class="atos">
        {atos.map((a) => (
          <li class="ato">
            <figure class="ato__obra">
              <Image src={a.obra} alt={a.alt} widths={[320, 480, 640]} sizes="(max-width: 40rem) 90vw, (max-width: 64rem) 45vw, 22vw" style={`object-position:${a.pos}`} />
              <figcaption>Caravaggio, <em>{a.legenda}</em>.</figcaption>
            </figure>
            <span class="ato__num">Ato {a.n}</span>
            <h3 class="ato__nome">{a.nome}</h3>
            <p class="ato__tema">{a.tema}</p>
            <blockquote class="ato__frase">“{a.frase}”</blockquote>
          </li>
        ))}
      </ol>
      <a class="btn atos__cta" href="#inscricao">Quero reservar meu lugar</a>
    </div>
  </section>

  <section class="faixa-nm" aria-labelledby="faixa-frase">
    <Image src={pozzo} alt="Teto pintado da Igreja de Santo Inácio, em Roma: céus abertos, nuvens e dezenas de figuras em perspectiva vertiginosa" widths={[800, 1200, 1650]} sizes="100vw" class="faixa-nm__img" />
    <div class="wrap faixa-nm__texto">
      <p class="faixa-nm__frase" id="faixa-frase">O Barroco quis emocionar todos os sentidos.<span>É isso que esta noite propõe.</span></p>
      <p class="faixa-nm__legenda">Andrea Pozzo, <em>Apoteose de Santo Inácio</em>. Igreja de Santo Inácio de Loyola, Roma.</p>
    </div>
  </section>

  <section class="secao" aria-labelledby="para-quem-titulo">
    <div class="wrap mc-paraquem">
      <div>
        <h2 id="para-quem-titulo" class="secao__titulo">Para quem é</h2>
        <p class="secao__voz">Para quem acredita que sempre é tempo de descobrir algo novo.</p>
      </div>
      <ul class="fatos">
        {paraQuem.map((f) => <li><span class="fatos__termo">{f.termo}</span><span class="fatos__texto">{f.texto}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="secao secao--petroleo mc-ciclos" aria-labelledby="ciclos-titulo">
    <div class="wrap">
      <div class="mc-ciclos__grade">
        <div>
          <p class="mc-ciclos__rotulo">Quem organiza</p>
          <h2 id="ciclos-titulo" class="secao__titulo">Conheça a CICLOS+</h2>
          <p class="secao__voz">A CICLOS+ já faz parte de Pelotas.</p>
        </div>
        <div class="mc-ciclos__texto">
          <p>
            A CICLOS+ é uma escola cultural para pessoas 60+. Aqui se aprende arte, filosofia, história, música
            e muito mais, sem provas e sem pressão, com professores de cada área e uma turma que vira companhia.
          </p>
          <p>
            A escola nasceu em Porto Alegre, onde a primeira turma se formou em 2020 e hoje reúne mais de 100 alunos.
            Em Pelotas, funciona no {u.local}{u.responsavel ? `, conduzida pela franqueada Bibiana Urdaniz` : ''}.
          </p>
          <ul class="mc-ciclos__assuntos" aria-label="Disciplinas da CICLOS+">
            {disciplinas.map((d) => <li>{d.nome}</li>)}
          </ul>
        </div>
      </div>

      <ul class="mc-ciclos__fotos">
        <li><Image src={fotoAula} alt="Professor conduz uma aula da CICLOS+ para uma sala cheia de alunos atentos" widths={[360, 560]} sizes="(max-width: 48rem) 90vw, 30vw" /></li>
        <li><Image src={fotoFesta} alt="Alunas da CICLOS+ comemoram com os braços para o alto numa confraternização" widths={[360, 560]} sizes="(max-width: 48rem) 90vw, 30vw" /></li>
        <li><Image src={fotoViagem} alt="Alunas da CICLOS+ observam de perto uma pintura impressionista num museu" widths={[360, 560]} sizes="(max-width: 48rem) 90vw, 30vw" /></li>
      </ul>
      <p class="mc-ciclos__nota">Aulas, confraternizações e viagens culturais: fotos da CICLOS+ em Porto Alegre.</p>
    </div>
  </section>

  <section class="secao secao--menta mc-caminho" aria-labelledby="caminho-titulo">
    <Marca tipo="simbolo" label={null} class="mc-caminho__marca" />
    <div class="wrap">
      <h2 id="caminho-titulo" class="secao__titulo">A masterclass é só o começo</h2>
      <p class="secao__voz">Quem vem à masterclass recebe em primeira mão o que vem depois.</p>
      <ol class="caminho">
        {caminho.map((c) => (
          <li class:list={{ 'is-atual': c.atual }}>
            <span class="caminho__quando">{c.quando}</span>
            <span class="caminho__titulo">{c.titulo}</span>
            <span class="caminho__texto">{c.texto}</span>
            {c.atual && <span class="caminho__aqui">Você está aqui</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao mc-faq" aria-labelledby="faq-titulo">
    <div class="wrap mc-faq__grade">
      <h2 id="faq-titulo" class="secao__titulo">Perguntas frequentes</h2>
      <div class="faq">
        {perguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
        <p class="faq__mais">Outra dúvida? <a href={wa} target="_blank" rel="noopener">Fale com a CICLOS+ Pelotas no WhatsApp</a>.</p>
      </div>
    </div>
  </section>

  <section class="mc-final" aria-labelledby="final-titulo">
    <Marca tipo="simbolo" label={null} class="mc-final__marca" />
    <div class="wrap mc-final__grade">
      <div>
        <h2 id="final-titulo" class="mc-final__titulo">Reserve seu lugar</h2>
        <p class="mc-final__voz">{ev.titulo}. {ev.quando}, {ev.horario}, no {ev.local!.nome}, em {u.cidade}. {ev.valor!.texto}.</p>
      </div>
      <div class="mc-final__acoes">
        <a class="btn mc-final__btn" href="#inscricao">Quero reservar meu lugar</a>
        <a class="mc-final__wa" href={wa} target="_blank" rel="noopener">Ou chame no WhatsApp {fone}</a>
      </div>
    </div>
  </section>

  <div class="barra-mc">
    <a class="btn barra-mc__btn" href="#inscricao">Reservar meu lugar</a>
    <a class="barra-mc__wa" href={wa} target="_blank" rel="noopener" aria-label="Falar no WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z" /><path d="M9.2 8.6c.2 2.6 2.2 4.9 4.9 5.6l1.2-1.3 1.9.9-.4 1.6c-3.8.3-7.9-3.6-8.3-7.4l1.6-.5.9 1.9z" class="barra-mc__fone" /></svg></a>
  </div>
</Base>

<script>
  // A barra fixa do celular some enquanto o formulário está à vista.
  const barra = document.querySelector<HTMLElement>('.barra-mc');
  const form = document.getElementById('inscricao');
  if (barra && form && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => barra.classList.toggle('is-oculta', e.isIntersecting), { threshold: 0.15 }).observe(form);
  }
</script>

<style>
  /* Abertura: campo petróleo com o formulário à vista */
  .mc-hero {
    position: relative; overflow: clip;
    background: var(--petrol) var(--tex-petrol) center / 1200px auto repeat;
    color: var(--on-petrol);
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3.5rem, 7vw, 6rem);
  }
  .mc-hero :global(.mc-hero__marca) {
    position: absolute; left: -10rem; bottom: -12rem; width: min(40rem, 70vw);
    color: var(--mint); opacity: 0.1; pointer-events: none;
  }
  .mc-hero__grade {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas: 'texto form' 'foto form';
    gap: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 5rem); align-items: start;
  }
  .mc-hero__texto { grid-area: texto; }
  .mc-hero__foto { grid-area: foto; margin: 0; }
  .mc-hero__form { grid-area: form; scroll-margin-top: 6.5rem; }

  .mc-hero__tipo { font-weight: 700; font-size: 0.95rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--yellow); }
  .mc-hero__titulo { margin-top: 0.75rem; font-size: clamp(3.75rem, 1.6rem + 6vw, 8rem); line-height: 0.86; color: var(--on-petrol); }
  .mc-hero__sub {
    margin-top: 0.9rem;
    font-style: italic; font-weight: 700; font-size: clamp(1.45rem, 1.1rem + 1.1vw, 2.15rem); line-height: 1.2;
    color: var(--yellow);
  }
  .mc-hero__voz {
    margin-top: 1.1rem; max-width: 30ch;
    font-style: italic; font-size: clamp(1.4rem, 1.05rem + 1vw, 2rem); line-height: 1.25; color: var(--on-petrol-soft);
  }

  .mc-fatos { margin: 1.75rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; max-width: 40rem; }
  .mc-fatos div { padding-block: 0.9rem; border-top: 1px solid rgba(199, 227, 234, 0.3); }
  .mc-fatos dt { font-family: var(--font-display); text-transform: uppercase; font-size: 1.7rem; line-height: 1; color: var(--mint); }
  .mc-fatos dd { margin: 0.35rem 0 0; color: var(--on-petrol); font-size: 1.1rem; line-height: 1.4; }
  .mc-hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; margin-top: 1.5rem; }
  .mc-hero .link-arrow { color: var(--lemon); }
  .mc-hero .link-arrow:hover { color: #fff; }
  .mc-hero__texto :focus-visible { outline-color: var(--yellow); }

  .mc-hero__foto :global(img) {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 999px 1.5rem 1.5rem 999px; border: 6px solid var(--yellow);
  }
