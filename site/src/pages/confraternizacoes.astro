---
import Base from '../layouts/Base.astro';
import Abertura from '../components/Abertura.astro';
import Galeria from '../components/Galeria.astro';
import Marca from '../components/Marca.astro';
import QueroConhecer from '../components/QueroConhecer.astro';
import { site, whatsappLink } from '../data/site';
import { unidadePorSlug } from '../data/unidades';
import { cafesDeSocializacao as cafe, noPalco2026, futuras, dataPorExtenso } from '../data/agenda';
import f1 from '../assets/img/Confraternizacoes - 06a.jpg';
import f2 from '../assets/img/Confraternizacoes - 20241025_1609472-scaled.jpg';
import f3 from '../assets/img/Confraternizacoes - 32.jpg';
import f4 from '../assets/img/Confraternizacoes - 3ed0acf4fd23.jpg';
import f5 from '../assets/img/Confraternizacoes - IMG_2716-scaled.jpg';
import f6 from '../assets/img/Confraternizacoes - IMG_27441-scaled.jpg';
import f7 from '../assets/img/Confraternizacoes - IMG_58841-scaled.jpg';

const ocasioes = [
  { termo: 'À mesa', texto: 'Jantares, almoços e cafés que viram extensão da aula.' },
  { termo: 'Datas especiais', texto: 'O fim de ano e outras datas que pedem comemoração.' },
  { termo: 'Entre turmas', texto: 'Um bom jeito de conhecer gente de outras disciplinas.' },
];

const unidadeCafe = unidadePorSlug(cafe.unidade)!;
const proximosCafes = futuras(cafe.datas);
const waCafe = whatsappLink(`Olá! Quero participar do ${cafe.titulo} da CICLOS+ ${unidadeCafe.cidade}.`, unidadeCafe.whatsapp?.e164);
const palcoFuturo = futuras([noPalco2026.data]).length > 0;
---
<Base
  title="Confraternizações · CICLOS+ Escola Cultural 60+"
  description="Na CICLOS+, as confraternizações vão além do encontro social: são parte do jeito de viver a maturidade com alegria, amizade e novas histórias para contar."
  imagem={f4}
>
  <Abertura
    campo="menta"
    titulo="Confraternizações"
    voz="Aqui é um lugar de pertencimento."
    trilha={[{ href: '/confraternizacoes', label: 'Confraternizações' }]}
    foto={{ src: f1, alt: 'Duas alunas sorriem juntas, de copo na mão, durante uma confraternização' }}
    posicao="50% 35%"
    forma="circulo"
    anel="papel"
  >
    <p>
      A CICLOS+ não oferece apenas cursos. As confraternizações vão muito além do encontro social:
      são parte do jeito CICLOS+ de viver a maturidade com alegria, amizade e novas histórias para contar.
    </p>
    <Fragment slot="acoes">
      <a class="btn" href="#quero-conhecer">Quero fazer parte</a>
      <a class="link-arrow" href={whatsappLink('Olá! Quero conhecer a CICLOS+.')} target="_blank" rel="noopener">Falar no WhatsApp</a>
    </Fragment>
  </Abertura>

  {proximosCafes.length > 0 && (
    <section class="secao secao--petroleo cafe" aria-labelledby="cafe-titulo">
      <div class="wrap cafe__grade">
        <div>
          <p class="cafe__unidade">Na unidade <a href={`/unidades/${unidadeCafe.slug}`}>{unidadeCafe.cidade}</a></p>
          <h2 id="cafe-titulo" class="secao__titulo">{cafe.titulo}</h2>
          <p class="secao__voz">{cafe.descricao}</p>
          <div class="cafe__acoes">
            <a class="btn" href={waCafe} target="_blank" rel="noopener">Quero participar</a>
            <a class="link-arrow" href={waCafe} target="_blank" rel="noopener">WhatsApp {unidadeCafe.cidade} {unidadeCafe.whatsapp?.display ?? site.whatsapp.display}</a>
          </div>
        </div>
        <div>
          <h3 class="cafe__subtitulo">Próximos encontros</h3>
          <ul class="cafe__datas">
            {proximosCafes.map((d) => <li>{dataPorExtenso(d)}</li>)}
          </ul>
          <p class="cafe__nota">Horários com a equipe da CICLOS+ {unidadeCafe.cidade}.</p>
        </div>
      </div>
    </section>
  )}

  <section class="secao" aria-labelledby="ocasioes-titulo">
    <div class="wrap ocasioes__grade">
      <div>
        <h2 id="ocasioes-titulo" class="secao__titulo">A aula continua à mesa</h2>
        <p class="secao__voz">O que começa numa disciplina vira amizade num jantar, num café ou numa festa de fim de ano.</p>
      </div>
      <ul class="fatos">
        {ocasioes.map((f) => <li><span class="fatos__termo">{f.termo}</span><span class="fatos__texto">{f.texto}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="secao secao--petroleo palco" aria-labelledby="palco-titulo">
    <Marca tipo="simbolo" label={null} class="palco__marca" />
    <div class="wrap palco__grade">
      <div>
        <p class="palco__quando">Porto Alegre · novembro de 2025</p>
        <h2 id="palco-titulo" class="palco__titulo">No Palco 60+<span>A vida em cartaz</span></h2>
      </div>
      <div class="palco__texto">
        <p>
          Um encontro que reuniu alunos, professores e convidados da CICLOS+ em torno de conversas sobre
          arte, filosofia e economia na maturidade, com apresentação do grupo de Aquarela e o lançamento
          da programação do ano seguinte.
        </p>
        <p>No encerramento, os professores subiram ao palco para tocar em banda.</p>
        {palcoFuturo && <p class="palco__proximo">Próxima edição: {dataPorExtenso(noPalco2026.data)}, em {noPalco2026.cidade}.</p>}
      </div>
    </div>
  </section>

  <Galeria
    id="momentos"
    titulo="Momentos juntos"
    voz="Fotos de confraternizações da CICLOS+ em Porto Alegre."
    fotos={[
      { src: f4, alt: 'Alunas comemoram com os braços para o alto num salão cheio' },
      { src: f5, alt: 'Alunas sorrindo à mesa num jantar de confraternização' },
      { src: f2, alt: 'Três amigas sorriem à mesa, com lanches e bebidas' },
      { src: f3, alt: 'Grupo reunido numa sala decorada para o Natal' },
      { src: f6, alt: 'Alunas sorriem para a foto num jantar com taças sobre a mesa' },
      { src: f7, alt: 'Três alunos posam juntos durante um encontro', pos: '50% 0%' },
      { src: f1, alt: 'Duas alunas brindam durante uma confraternização' },
    ]}
  />

  <QueroConhecer assunto="Confraternizações" />
</Base>

<style>
  .ocasioes__grade { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }

  .cafe__grade { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .cafe__unidade { font-weight: 700; font-size: 1rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--yellow); margin-bottom: 0.75rem; }
  .cafe__unidade a { color: inherit; }
  .cafe__unidade a:hover { color: #fff; }
  .cafe__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2rem; }
  .cafe__subtitulo { font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.6rem); color: var(--mint); }
  .cafe__datas { list-style: none; margin: 1.25rem 0 0; padding: 0; border-top: 1px solid rgba(199, 227, 234, 0.3); }
  .cafe__datas li {
    padding-block: 0.9rem; border-bottom: 1px solid rgba(199, 227, 234, 0.3);
    font-family: var(--font-display); text-transform: uppercase; font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.2rem); line-height: 1; color: var(--on-petrol);
  }
  .cafe__nota { margin-top: 1rem; font-style: italic; color: var(--on-petrol-soft); font-size: 1rem; }
  .palco__proximo { font-weight: 700; color: var(--yellow); }

  .palco { position: relative; overflow: clip; }
  .palco :global(.palco__marca) { position: absolute; right: -6rem; bottom: -8rem; width: min(30rem, 55vw); color: var(--mint); opacity: 0.16; pointer-events: none; }
  .palco__grade { position: relative; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: end; }
  .palco__quando { font-weight: 700; font-size: 0.95rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-petrol-soft); }
  .palco__titulo { margin-top: 0.75rem; font-size: clamp(3.5rem, 2rem + 5vw, 7.5rem); line-height: 0.88; color: var(--on-petrol); }
  .palco__titulo span { display: block; color: var(--mint); font-size: 0.55em; margin-top: 0.4rem; }
  .palco__texto { display: grid; gap: 1rem; color: var(--on-petrol-soft); max-width: 44ch; }
  .palco__texto p:first-child { color: var(--on-petrol); }

  @media (max-width: 56rem) {
    .ocasioes__grade, .palco__grade, .cafe__grade { grid-template-columns: 1fr; }
  }
</style>
