---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Abertura from '../../components/Abertura.astro';
import Marca from '../../components/Marca.astro';
import QueroConhecer from '../../components/QueroConhecer.astro';
import { disciplinas, comoFunciona, grade, type Disciplina } from '../../data/disciplinas';
import { whatsappLink } from '../../data/site';
import aulaReal from '../../assets/img/Disciplinas Semestrais - IMG_9955-scaled.jpg';

export function getStaticPaths() {
  return disciplinas.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
interface Props { d: Disciplina }
const { d } = Astro.props;

const outras = disciplinas.filter((o) => o.slug !== d.slug);
const fotoAula = d.fotoAula ?? { src: aulaReal, alt: 'Professor conduz uma aula da CICLOS+ para uma sala cheia de alunos atentos', legenda: 'Aula na CICLOS+ Porto Alegre.' };
const legendaAula = [fotoAula.legenda, fotoAula.ilustrativa ? 'Imagem ilustrativa.' : ''].filter(Boolean).join(' ');
---
<Base
  title={`${d.nome} · Disciplina semestral · CICLOS+ Escola Cultural 60+`}
  description={`${d.frase} ${d.resumo}`}
  imagem={d.foto.src}
>
  <Abertura
    sobretitulo={d.subtitulo ? `Disciplina semestral · ${d.subtitulo}` : 'Disciplina semestral'}
    titulo={d.nome}
    voz={d.frase}
    trilha={[{ href: '/disciplinas', label: 'Disciplinas' }, { href: `/disciplinas/${d.slug}`, label: d.nome }]}
    foto={d.foto}
    forma="eliptico"
  >
    <p>{d.resumo}</p>
    <Fragment slot="acoes">
      <a class="btn" href="#quero-conhecer">Quero conhecer</a>
      <a class="link-arrow" href={whatsappLink(`Olá! Quero saber da disciplina de ${d.nome} na CICLOS+.`)} target="_blank" rel="noopener">Falar no WhatsApp</a>
    </Fragment>
  </Abertura>

  <section class="secao secao--petroleo sobre-disc" aria-labelledby="sobre-titulo">
    <div class="wrap sobre-disc__grade">
      <div>
        <h2 id="sobre-titulo" class="secao__titulo">Sobre a disciplina</h2>
        <div class="sobre-disc__texto">
          {d.texto.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div>
        <h3 class="sobre-disc__subtitulo">Perguntas que movem a turma</h3>
        <ul class="perguntas">
          {d.perguntas.map((p) => (
            <li><Marca tipo="simbolo" label={null} class="perguntas__marca" /><span>{p}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="secao funciona" aria-labelledby="funciona-titulo">
    <div class="wrap funciona__grade">
      <div>
        <h2 id="funciona-titulo" class="secao__titulo">Quando e como</h2>
        <div class="horario">
          <p class="horario__rotulo">Em Porto Alegre · grade {grade.periodo}</p>
          <ul class="horario__lista">
            {d.horarios.map((h) => (
              <li>
                <span class="horario__dia">{h.dia}</span>
                <span class="horario__hora">{h.hora}{h.turma && <em> · {h.turma}</em>}</span>
              </li>
            ))}
          </ul>
          <p class="horario__nota">Em Pelotas, a programação é montada para a cidade. <a href="/unidades/pelotas">Veja a unidade Pelotas</a> ou pergunte pelo WhatsApp.</p>
        </div>
        <ul class="fatos funciona__fatos">
          {comoFunciona.map((f) => (
            <li><span class="fatos__termo">{f.termo}</span><span class="fatos__texto">{f.texto}</span></li>
          ))}
        </ul>
      </div>
      <figure class="funciona__foto">
        <Image src={fotoAula.src} alt={fotoAula.alt} widths={[400, 640, 880]} sizes="(max-width: 56rem) 90vw, 36vw" style={fotoAula.pos ? `object-position:${fotoAula.pos}` : undefined} />
        {legendaAula && <figcaption>{legendaAula}</figcaption>}
      </figure>
    </div>
  </section>

  <nav class="outras" aria-labelledby="outras-titulo">
    <div class="wrap">
      <h2 id="outras-titulo" class="outras__titulo">Outras disciplinas</h2>
      <ul class="outras__lista">
        {outras.map((o) => <li><a href={`/disciplinas/${o.slug}`}>{o.nome}</a></li>)}
      </ul>
      <a class="link-arrow" href="/disciplinas">Ver todas as disciplinas</a>
    </div>
  </nav>

  <QueroConhecer assunto={d.nome} />
</Base>

<style>
  .sobre-disc__grade { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .sobre-disc__texto { margin-top: 1.75rem; display: grid; gap: 1.1rem; max-width: 46ch; color: var(--on-petrol-soft); }
  .sobre-disc__texto p:first-child { color: var(--on-petrol); font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.45rem); line-height: 1.55; }
  .sobre-disc__subtitulo { font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.6rem); color: var(--mint); }
  .perguntas { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 1px solid rgba(199, 227, 234, 0.25); }
  .perguntas li {
    display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; align-items: start;
    padding-block: 1.1rem; border-bottom: 1px solid rgba(199, 227, 234, 0.25);
    font-style: italic; font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.6rem); line-height: 1.3; color: var(--on-petrol);
  }
  .perguntas :global(.perguntas__marca) { width: 2rem; color: var(--mint); margin-top: 0.15rem; }

  .funciona__grade { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .horario {
    margin-top: 2rem; padding: clamp(1.25rem, 2.6vw, 2rem);
    border-radius: 1.5rem; background: var(--paper-2); color: var(--ink);
  }
  .horario__rotulo { font-weight: 700; font-size: 0.9rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--teal-ink); }
  .horario__lista { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.35rem; }
  .horario__lista li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; }
  .horario__dia { font-family: var(--font-display); text-transform: uppercase; font-size: clamp(2.5rem, 2rem + 1.6vw, 3.5rem); line-height: 1; color: var(--petrol); }
  .horario__hora { font-weight: 700; font-size: 1.2rem; }
  .horario__hora em { font-weight: 400; }
  .horario__nota { margin-top: 1rem; font-size: 1.05rem; }
  .horario__nota { color: var(--ink-soft); }
  .horario__nota a { color: var(--teal-ink); font-weight: 700; }
  .funciona__fatos { margin-top: 2.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .funciona__foto { margin: 0; }
  .funciona__foto :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 1.5rem 999px 999px 1.5rem;
    box-shadow: 0 30px 60px -40px rgba(0, 61, 89, 0.6);
  }
  .funciona__foto figcaption { margin-top: 0.9rem; font-style: italic; font-size: 1rem; color: var(--ink-soft); }

  .outras { padding-block: 0 clamp(4.5rem, 9vw, 8rem); }
  .outras .wrap { position: relative; padding-top: clamp(3rem, 5vw, 4rem); }
  .outras .wrap::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 2px; background: var(--petrol); }
  .outras__titulo { font-size: clamp(2.25rem, 1.6rem + 2vw, 3.5rem); color: var(--petrol); }
  .outras__lista { list-style: none; margin: 1.5rem 0 2rem; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0; }
  .outras__lista li { display: inline-flex; align-items: center; }
  .outras__lista li + li::before { content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--mint); margin-inline: clamp(0.9rem, 1.6vw, 1.4rem); }
  .outras__lista a {
    font-family: var(--font-display); text-transform: uppercase; font-size: clamp(1.9rem, 1.5rem + 1.4vw, 3rem); line-height: 1.15;
    color: var(--petrol); text-decoration: none;
    background: linear-gradient(var(--yellow), var(--yellow)) left 92% / 0 3px no-repeat;
    transition: background-size 0.35s var(--ease-out), color 0.3s;
  }
  .outras__lista li:nth-child(even) a { color: var(--teal-ink); }
  .outras__lista a:hover { background-size: 100% 3px; }

  @media (max-width: 56rem) {
    .sobre-disc__grade, .funciona__grade { grid-template-columns: 1fr; }
    .funciona__foto { max-width: 28rem; }
  }
  @media (max-width: 30rem) { .funciona__fatos { grid-template-columns: 1fr; } }
</style>
